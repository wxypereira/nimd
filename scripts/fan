#!/usr/bin/env bash
# fan — Otimizador de ventoinhas PWM via hwmon/thermal
# Uso: fan <probe|apply|status|revert> [opções]
# Saída: JSON Lines em stdout, logs em stderr

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/common"
source "${SCRIPT_DIR}/lib/thermal"

# ========== CONSTANTES ==========
readonly HW_MON_BASE="/sys/class/hwmon"
readonly THERMAL_BASE="/sys/class/thermal"
readonly PWM_MIN=0
readonly PWM_MAX=255
readonly TEMP_MIN=0
readonly TEMP_MAX=120

# Curvas PWM: "temp:pwm" (pwm em 0-255)
SILENT_CURVE=("30:30" "40:35" "50:45" "60:55" "70:70" "80:100")
BALANCED_CURVE=("30:30" "40:45" "50:60" "60:75" "70:100" "80:255")
PERFORMANCE_CURVE=("25:40" "35:60" "45:85" "55:120" "65:180" "75:255")

JSON_OUTPUT=false
DRY_RUN=false
VERBOSE=false
QUIET=false
STATE_DIR="/var/lib/nimd/state"
STATE_FILE="${STATE_DIR}/fan.json"

# ========== HELP ==========
usage() {
    cat <<'EOF'
Fan Optimizer — Controle PWM de ventoinhas

USO:
    fan <comando> [opções]

COMANDOS:
    probe           Detecta ventoinhas PWM controláveis
    apply           Aplica perfil (silent|balanced|performance|custom)
    status          Mostra estado atual
    revert          Restaura estado anterior

OPÇÕES:
    --profile <p>   Perfil: silent, balanced, performance, custom
    --curve <str>   Curva custom: "30:30,50:60,70:100" (temp:pwm%)
    --json          Saída JSON Lines
    --dry-run       Simula sem aplicar
    --verbose       Logs detalhados
    --quiet         Apenas erros/resultados
    --help          Esta ajuda

EXEMPLOS:
    fan probe --json
    fan apply --profile balanced --json
    fan apply --profile custom --curve "30:30,50:60,80:100" --json
    fan status --json
    fan revert --json
EOF
}

# ========== JSON HELPERS ==========
json_emit() { [[ "$JSON_OUTPUT" == true ]] && printf '%s\n' "$1"; }
json_progress() { json_emit "$(jq -n --arg type "progress" --arg stage "$1" --argjson current "$2" --argjson total "$3" --argjson percent "$4" --arg msg "$5" '{type:$type, stage:$stage, current:$current, total:$total, percent:$percent, message:$msg}')"; }
json_result() { json_emit "$(jq -n --arg type "result" --arg section "$1" --argjson data "$2" '{type:$type, section:$section, data:$data}')"; }
json_complete() { json_emit "$(jq -n --arg type "complete" --argjson exit_code "$1" --argjson duration_ms "$2" --arg msg "$3" '{type:$type, exit_code:$exit_code, duration_ms:$duration_ms, message:$msg}')"; }
json_error() { json_emit "$(jq -n --arg type "error" --arg code "$1" --arg msg "$2" '{type:$type, code:$code, message:$msg}')"; }

# ========== UTILITÁRIOS ==========
ensure_state_dir() { mkdir -p "$STATE_DIR"; }

clamp_pwm() { local v=$1; (( v < PWM_MIN )) && v=$PWM_MIN; (( v > PWM_MAX )) && v=$PWM_MAX; echo $v; }
clamp_temp() { local v=$1; (( v < TEMP_MIN )) && v=$TEMP_MIN; (( v > TEMP_MAX )) && v=$TEMP_MAX; echo $v; }

parse_curve() {
    local curve_str="$1" IFS=','; local -a points=()
    for pair in $curve_str; do
        local temp="${pair%%:*}" pwm="${pair##*:}"
        [[ "$temp" =~ ^[0-9]+$ ]] && [[ "$pwm" =~ ^[0-9]+$ ]] || { log_err "Ponto inválido: $pair"; return 1; }
        temp=$(clamp_temp "$temp")
        pwm=$(clamp_pwm "$(( pwm * 255 / 100 ))")
        points+=("$temp:$pwm")
    done
    IFS=$'\n' points=($(sort -t: -k1,1n <<<"${points[*]}"))
    printf '%s\n' "${points[@]}"
}

interpolate_pwm() {
    local temp=$1; shift
    local -a curve=("$@")
    [[ ${#curve[@]} -eq 0 ]] && { echo 128; return; }
    local first="${curve[0]}" last="${curve[-1]}"
    local t1="${first%%:*}" p1="${first##*:}"
    local t2="${last%%:*}" p2="${last##*:}"
    (( temp <= t1 )) && { echo $p1; return; }
    (( temp >= t2 )) && { echo $p2; return; }
    for point in "${curve[@]}"; do
        local t="${point%%:*}" p="${point##*:}"
        (( temp == t )) && { echo $p; return; }
    done
    for i in $(seq 0 $((${#curve[@]} - 2))); do
        local t1="${curve[i]%%:*}" p1="${curve[i]##*:}"
        local t2="${curve[i+1]%%:*}" p2="${curve[i+1]##*:}"
        if (( temp > t1 && temp < t2 )); then
            local ratio=$(( (temp - t1) * 1000 / (t2 - t1) ))
            local pwm=$(( p1 + ratio * (p2 - p1) / 1000 ))
            echo $pwm
            return
        fi
    done
    echo $p2
}

get_highest_temp() {
    local -a temps=()
    for hwmon in "$HW_MON_BASE"/hwmon*; do
        [[ -d "$hwmon" ]] || continue
        for temp_file in "$hwmon"/temp*_input; do
            [[ -r "$temp_file" ]] || continue
            local val=$(cat "$temp_file" 2>/dev/null)
            [[ "$val" =~ ^[0-9]+$ ]] && temps+=("$((val / 1000))")
        done
    done
    for zone in "$THERMAL_BASE"/thermal_zone*/temp; do
        [[ -r "$zone" ]] || continue
        local val=$(cat "$zone" 2>/dev/null)
        [[ "$val" =~ ^[0-9]+$ ]] && temps+=("$((val / 1000))")
    done
    [[ ${#temps[@]} -gt 0 ]] && printf '%s\n' "${temps[@]}" | sort -nr | head -1
}

probe_fans() {
    local -a devices=()
    [[ -d "$HW_MON_BASE" ]] || { json_error "HARDWARE_NOT_FOUND" "hwmon sysfs not found"; return 1; }

    for hwmon in "$HW_MON_BASE"/hwmon*; do
        [[ -d "$hwmon" ]] || continue
        local name=$(cat "$hwmon/name" 2>/dev/null || basename "$hwmon")
        for pwm_enable in "$hwmon"/pwm*_enable; do
            [[ -f "$pwm_enable" ]] || continue
            local num="${pwm_enable##*pwm}"; num="${num%_enable}"
            local pwm_file="$hwmon/pwm$num"
            [[ -f "$pwm_file" ]] || continue
            local enable_val=$(cat "$pwm_enable" 2>/dev/null)
            [[ "$enable_val" =~ ^[012]$ ]] || continue
            local fan_file="$hwmon/fan${num}_input"
            [[ -f "$fan_file" ]] || fan_file=""
            local -a temp_files=()
            for tf in "$hwmon"/temp*_input; do [[ -r "$tf" ]] && temp_files+=("$tf"); done
            [[ ${#temp_files[@]} -eq 0 ]] && continue

            devices+=($(jq -n \
                --arg hwmon "$hwmon" \
                --arg name "$name" \
                --arg pwm_enable "$pwm_enable" \
                --arg pwm "$pwm_file" \
                --arg fan "${fan_file:-}" \
                --argjson temps "$(printf '%s\n' "${temp_files[@]}" | jq -R . | jq -s .)" \
                '{hwmon:$hwmon, name:$name, pwm_enable:$pwm_enable, pwm:$pwm, fan:$fan, temps:$temps}'))
        done
    done

    if [[ ${#devices[@]} -eq 0 ]]; then
        json_error "HARDWARE_NOT_FOUND" "No PWM-controllable fans found"
        return 1
    fi

    printf '%s\n' "${devices[@]}" | jq -s .
}

apply_fan() {
    local profile="$1" custom_curve="$2"
    local -a curve=()
    case "$profile" in
        silent) IFS=$'\n' curve=($(printf '%s\n' "${SILENT_CURVE[@]}")) ;;
        balanced) IFS=$'\n' curve=($(printf '%s\n' "${BALANCED_CURVE[@]}")) ;;
        performance) IFS=$'\n' curve=($(printf '%s\n' "${PERFORMANCE_CURVE[@]}")) ;;
        custom)
            [[ -n "$custom_curve" ]] || { json_error "INVALID_PROFILE" "CUSTOM requires --curve"; return 1; }
            mapfile -t curve < <(parse_curve "$custom_curve") || return 1
            ;;
        *) json_error "INVALID_PROFILE" "Unknown profile: $profile"; return 1 ;;
    esac

    local devices_json
    devices_json=$(probe_fans) || return 1
    local device_count=$(echo "$devices_json" | jq 'length')
    [[ $device_count -eq 0 ]] && { json_error "HARDWARE_NOT_FOUND" "No fan devices"; return 1; }

    ensure_state_dir
    local -a reverted=() applied=() warnings=()
    local start_ms=$(date +%s%3N)

    for i in $(seq 0 $((device_count - 1))); do
        local dev=$(echo "$devices_json" | jq ".[$i]")
        local hwmon=$(echo "$dev" | jq -r .hwmon)
        local name=$(echo "$dev" | jq -r .name)
        local pwm_enable=$(echo "$dev" | jq -r .pwm_enable)
        local pwm_file=$(echo "$dev" | jq -r .pwm)

        local orig_enable=$(cat "$pwm_enable" 2>/dev/null || echo "")
        local orig_pwm=$(cat "$pwm_file" 2>/dev/null || echo "")
        reverted+=($(jq -n --arg hwmon "$hwmon" --arg enable "$orig_enable" --arg pwm "$orig_pwm" '{hwmon:$hwmon, pwm_enable:$enable, pwm:$pwm}'))

        [[ "$DRY_RUN" == true ]] && { log_warn "DRY-RUN: $name pwm_enable=1"; continue; }

        echo 1 > "$pwm_enable" 2>/dev/null || { warnings+=("$name: Failed to set manual mode"); continue; }

        local temp=$(get_highest_temp)
        [[ -z "$temp" ]] && { warnings+=("$name: No temperature reading"); temp=40; }

        local pwm_val=$(interpolate_pwm "$temp" "${curve[@]}")
        echo "$pwm_val" > "$pwm_file" 2>/dev/null || { warnings+=("$name: Failed to write PWM $pwm_val"); continue; }

        applied+=($(jq -n --arg hwmon "$hwmon" --argjson temp "$temp" --argjson pwm "$pwm_val" --argjson pct "$(( pwm_val * 100 / 255 ))" '{hwmon:$hwmon, temp_c:$temp, pwm_value:$pwm, pwm_percent:$pct}'))
    done

    local state=$(jq -n --argjson reverted "$(printf '%s\n' "${reverted[@]}" | jq -s .)" '{devices:$reverted}')
    echo "$state" > "$STATE_FILE"

    local end_ms=$(date +%s%3N)
    local success=$(echo "$applied" | jq -s 'length > 0')
    json_result "applied" "$(printf '%s\n' "${applied[@]}" | jq -s .)"
    json_result "reverted" "$state"
    [[ ${#warnings[@]} -gt 0 ]] && json_result "warnings" "$(printf '%s\n' "${warnings[@]}" | jq -R . | jq -s .)"
    json_complete $([[ "$success" == true ]] && echo 0 || echo 1) $((end_ms - start_ms)) $([[ "$success" == true ]] && echo "Fan profile applied" || echo "No devices configured")
}

status_fan() {
    local devices_json
    devices_json=$(probe_fans) || return 1
    local device_count=$(echo "$devices_json" | jq 'length')
    local -a devices_out=()
    local active=0

    for i in $(seq 0 $((device_count - 1))); do
        local dev=$(echo "$devices_json" | jq ".[$i]")
        local hwmon=$(echo "$dev" | jq -r .hwmon)
        local name=$(echo "$dev" | jq -r .name)
        local pwm_enable=$(echo "$dev" | jq -r .pwm_enable)
        local pwm_file=$(echo "$dev" | jq -r .pwm)
        local fan_file=$(echo "$dev" | jq -r .fan)
        local -a temps=()

        local enable_val=$(cat "$pwm_enable" 2>/dev/null || echo "")
        local pwm_val=$(cat "$pwm_file" 2>/dev/null || echo "")
        local fan_rpm=""
        [[ -n "$fan_file" && -r "$fan_file" ]] && fan_rpm=$(cat "$fan_file" 2>/dev/null || echo "")

        for tf in $(echo "$dev" | jq -r '.temps[]'); do
            local val=$(cat "$tf" 2>/dev/null || echo "")
            [[ "$val" =~ ^[0-9]+$ ]] && temps+=("$((val / 1000))")
        done

        [[ "$enable_val" == "1" ]] && ((active++))

        devices_out+=($(jq -n \
            --arg hwmon "$hwmon" --arg name "$name" \
            --arg enable "$enable_val" --arg pwm "$pwm_val" --arg fan "$fan_rpm" \
            --argjson temps "$(printf '%s\n' "${temps[@]}" | jq -R . | jq -s .)" \
            --argjson max_temp "$(printf '%s\n' "${temps[@]}" | sort -nr | head -1)" \
            '{hwmon:$hwmon, name:$name, pwm_enable:($enable|tonumber?), pwm_value:($pwm|tonumber?), pwm_percent:(($pwm|tonumber?)*100/255), fan_rpm:($fan|tonumber?), temperatures_c:$temps, max_temp_c:$max_temp}'))
    done

    local metrics=$(jq -n --argjson total "$device_count" --argjson active "$active" '{total_devices:$total, active_devices:$active}')
    json_result "status" "$(jq -n --arg profile "$(cat "$STATE_FILE" 2>/dev/null | jq -r .profile // \"unknown\")" --argjson metrics "$metrics" --argjson devices "$(printf '%s\n' "${devices_out[@]}" | jq -s .)" '{current_profile:$profile, metrics:$metrics, devices:$devices}')"
}

revert_fan() {
    [[ -f "$STATE_FILE" ]] || { json_error "HARDWARE_NOT_FOUND" "No saved state"; return 1; }
    local state=$(cat "$STATE_FILE")
    local device_count=$(echo "$state" | jq '.devices | length')
    local -a reverted=() warnings=()
    local success_count=0

    for i in $(seq 0 $((device_count - 1))); do
        local dev=$(echo "$state" | jq ".devices[$i]")
        local hwmon=$(echo "$dev" | jq -r .hwmon)
        local orig_enable=$(echo "$dev" | jq -r .pwm_enable)
        local orig_pwm=$(echo "$dev" | jq -r .pwm)
        local ok=true

        [[ -n "$orig_enable" && "$orig_enable" != "null" ]] && { echo "$orig_enable" > "$hwmon/$(basename "$(echo "$dev" | jq -r .pwm_enable)")" 2>/dev/null || { warnings+=("$hwmon: Failed to restore pwm_enable"); ok=false; }; }
        [[ -n "$orig_pwm" && "$orig_pwm" != "null" ]] && { echo "$orig_pwm" > "$hwmon/$(basename "$(echo "$dev" | jq -r .pwm)")" 2>/dev/null || { warnings+=("$hwmon: Failed to restore pwm"); ok=false; }; }

        [[ "$ok" == true ]] && ((success_count++))
        reverted+=($(jq -n --arg hwmon "$hwmon" --arg enable "$orig_enable" --arg pwm "$orig_pwm" '{hwmon:$hwmon, restored_pwm_enable:$enable, restored_pwm:$pwm}'))
    done

    rm -f "$STATE_FILE"
    json_result "reverted" "$(printf '%s\n' "${reverted[@]}" | jq -s .)"
    [[ ${#warnings[@]} -gt 0 ]] && json_result "warnings" "$(printf '%s\n' "${warnings[@]}" | jq -R . | jq -s .)"
    json_complete $([[ $success_count -gt 0 ]] && echo 0 || echo 1) 0 $([[ $success_count -gt 0 ]] && echo "Fan state reverted" || echo "No devices reverted")
}

# ========== MAIN ==========
main() {
    # Parse global options manually (getopts doesn't handle long options well)
    while [[ $# -gt 0 ]]; do
        case $1 in
            --json) JSON_OUTPUT=true; shift ;;
            -j) JSON_OUTPUT=true; shift ;;
            --dry-run) DRY_RUN=true; shift ;;
            -d) DRY_RUN=true; shift ;;
            --verbose) VERBOSE=true; shift ;;
            -v) VERBOSE=true; shift ;;
            --quiet) QUIET=true; shift ;;
            -q) QUIET=true; shift ;;
            --help) usage; exit 0 ;;
            -h) usage; exit 0 ;;
            --) shift; break ;;
            -*) log_err "Unknown option: $1"; usage; exit 4 ;;
            *) break ;;
        esac
    done

    local cmd="${1:-help}"
    shift || true

    local profile="" curve=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --profile) profile="$2"; shift 2 ;;
            --curve) curve="$2"; shift 2 ;;
            *) log_err "Unknown option: $1"; usage; exit 4 ;;
        esac
    done

    local start_ms=$(date +%s%3N)
    case $cmd in
        probe)
            probe_fans
            ;;
        apply)
            [[ -n "$profile" ]] || { log_err "--profile required"; exit 4; }
            apply_fan "$profile" "$curve"
            ;;
        status)
            status_fan
            ;;
        revert)
            revert_fan
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            log_err "Unknown command: $cmd"
            usage
            exit 4
            ;;
    esac
}

[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main "$@"